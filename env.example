# ---- Student credentials (required) ----
# Login fields on the portal: Session, Program, Roll No, Password
ROLL_NO=
SESSION=
PROGRAM=
PASSWORD=

# ---- Additional students (optional) ----
# Any prefix ending in ROLL_NO works; each needs its own SESSION / PROGRAM / PASSWORD with the same prefix.
# S2_ROLL_NO=
# S2_SESSION=
# S2_PROGRAM=
# S2_PASSWORD=

# ---- Portal settings (optional) ----
PORTAL_BASE_URL=https://cms.must.edu.pk:8082
# true/1/yes to verify the SSL certificate (default: false)
VERIFY_SSL=false
# Seconds to wait after each request (default: 0)
REQUEST_DELAY=0

# ---- Feedback content (optional) ----
# Radio value used for every question
FEEDBACK_RATING=rdExcellent
FEEDBACK_COMMENT=Feedback Given By Bot.
